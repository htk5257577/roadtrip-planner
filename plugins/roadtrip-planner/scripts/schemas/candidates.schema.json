{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "sourceNotes", "candidates"],
  "properties": {
    "summary": { "type": "string" },
    "sourceNotes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "segment", "after", "order", "detour", "drive",
          "stay", "tags", "pet", "ev", "reason", "lon", "lat", "highlight"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "segment": { "type": "string" },
          "after": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "detour": { "type": "number", "description": "Incremental road km versus the current route without this candidate." },
          "drive": { "type": "number", "description": "Incremental hours of driving plus EV charging versus the current route without this candidate; exclude stay/visit time." },
          "stay": { "type": "number", "minimum": 0.25 },
          "tags": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true,
            "description": "Multiple factual experience tags for this destination, from the canonical vocabulary only; do not include pet, charging, crowd, or effort constraints.",
            "items": { "type": "string", "enum": ["地方美食", "历史街巷", "民族文化", "沙滩", "海岛", "海岸线", "山岳", "峡谷", "湖泊", "河流", "草原", "沙漠", "风景公路"] }
          },
          "pet": { "type": "string" },
          "ev": { "type": "string" },
          "reason": { "type": "string" },
          "lon": { "type": "number" },
          "lat": { "type": "number" },
          "highlight": { "type": "string" }
        }
      }
    }
  }
}
