{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "sourceNotes", "candidates"],
  "properties": {
    "summary": { "type": "string" },
    "sourceNotes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "segment", "after", "order", "detour", "drive",
          "stay", "tags", "pet", "ev", "reason", "lon", "lat", "highlight",
          "verdict", "confidence", "overlap", "references"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "segment": { "type": "string" },
          "after": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "detour": { "type": ["number", "null"], "minimum": 0, "description": "Incremental road km. Use null when no verified road result is available; never invent it." },
          "drive": { "type": ["number", "null"], "minimum": 0, "description": "Incremental driving plus EV charging hours. Use null when unverified; never invent it." },
          "stay": { "type": "number", "minimum": 0.25 },
          "tags": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true,
            "description": "Multiple factual experience tags for this destination, from the canonical vocabulary only; do not include pet, charging, crowd, or effort constraints.",
            "items": { "type": "string", "enum": ["地方美食", "历史街巷", "民族文化", "沙滩", "海岛", "海岸线", "山岳", "峡谷", "湖泊", "河流", "草原", "沙漠", "风景公路"] }
          },
          "pet": { "type": "string" },
          "ev": { "type": "string" },
          "reason": { "type": "string" },
          "lon": { "type": ["number", "null"] },
          "lat": { "type": ["number", "null"] },
          "highlight": { "type": "string" },
          "verdict": { "type": "string", "enum": ["推荐", "可选", "谨慎"] },
          "confidence": { "type": "string", "enum": ["高", "中", "低"] },
          "overlap": { "type": "string", "description": "Explain overlap or complementarity with locked stops." },
          "references": {
            "type": "array", "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["type", "platform", "title", "note", "url", "evidenceRole", "publicAccess", "checkedAt"],
              "properties": {
                "type": { "type": "string" }, "platform": { "type": "string" },
                "title": { "type": "string" }, "note": { "type": "string" },
                "url": { "type": "string", "pattern": "^https://" },
                "evidenceRole": { "type": "string", "enum": ["firstHand", "official"] },
                "publicAccess": { "const": true }, "checkedAt": { "type": "string", "format": "date-time" },
                "publishedAt": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
