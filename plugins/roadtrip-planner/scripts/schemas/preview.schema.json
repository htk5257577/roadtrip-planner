{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "routeOrder", "totals", "days", "notes", "sourceNotes"],
  "properties": {
    "status": { "const": "completed" },
    "summary": { "type": "string" },
    "routeOrder": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distanceKm", "driveHours", "chargeHours", "playHours", "pressure", "distanceSource"],
      "properties": {
        "distanceKm": { "type": "number", "minimum": 0 },
        "driveHours": { "type": "number", "minimum": 0 },
        "chargeHours": { "type": "number", "minimum": 0 },
        "playHours": { "type": "number", "minimum": 0 },
        "pressure": { "type": "string" },
        "distanceSource": { "type": "string" }
      }
    },
    "days": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["date", "title", "route", "distanceKm", "driveHours", "chargeHours", "playHours", "activities", "lodging"],
        "properties": {
          "date": { "type": "string" },
          "title": { "type": "string" },
          "route": { "type": "string" },
          "distanceKm": { "type": "number", "minimum": 0 },
          "driveHours": { "type": "number", "minimum": 0 },
          "chargeHours": { "type": "number", "minimum": 0 },
          "playHours": { "type": "number", "minimum": 0 },
          "activities": { "type": "string" },
          "lodging": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sourceNotes": { "type": "array", "items": { "type": "string" } }
  }
}
